# 服务器配置
HOST=0.0.0.0
PORT=8000

# 下载配置
DOWNLOAD_DIR=./downloads
MAX_FILE_SIZE=2147483648

# 可选：服务端已有权限的 Netscape 格式 Cookie 文件（绝对路径）
# YTDLP_COOKIE_FILE=/absolute/path/to/cookies.txt
# 可选：密码保护视频的已知密码
# YTDLP_VIDEO_PASSWORD=

# CORS 配置
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# 三个功能共用的云端服务（OpenAI 兼容接口，密钥仅配置在服务端）
CLOUD_BASE_URL=https://api.openai.com/v1
CLOUD_API_KEY=
# openai: /chat/completions；anthropic: /v1/messages
CLOUD_PROTOCOL=openai
AI_MAX_OUTPUT_TOKENS=16384
CLOUD_ASR_MODEL=whisper-1
CLOUD_TRANSLATION_MODEL=gpt-4o-mini
CLOUD_SUMMARY_MODEL=gpt-4o-mini

# 默认使用云端；需要单独的服务时，可覆盖下列地址和密钥
AI_PROVIDER=openai
# 自定义兼容服务：设置 AI_PROVIDER=custom，并明确填写共享地址、密钥和模型名
# AI_BASE_URL=
# AI_API_KEY=
# AI_MODEL=  # 未单独指定云端翻译 / 总结模型时的备用模型
# 本地 Ollama：AI_PROVIDER=ollama，AI_BASE_URL=http://localhost:11434/v1
# AI_MODEL 设置为已安装的本地模型名称；Ollama 无需 API Key

# 语音转文字：api 或 local
ASR_BACKEND=api
# ASR_BASE_URL=
# ASR_MODEL=
# ASR_API_KEY=  # 未配置时使用 CLOUD_API_KEY
# 本地模式：安装 requirements-asr.txt，设置 ASR_BACKEND=local、ASR_MODEL=base
# 首次本地转写会下载 Whisper 模型；小型 CPU 测试可使用 ASR_MODEL=tiny
ANALYSIS_MAX_DURATION=7200
